{
    "name": "icordeiro/sales-integration-worker",
    "description": "Reliable sales integration worker for exporting data from PostgreSQL to SFTP with audit trail, reprocessing and monitoring.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-pdo_sqlite": "*",
        "orbiit/router": "^1.1",
        "phpseclib/phpseclib": "^3.0",
        "twig/twig": "^3.28",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "test:database": "@php bin/test-database.php",
        "test:sales": "@php bin/test-sales-query.php"
    },
    "require-dev": {
        "phpunit/phpunit": "13.2"
    }
}
