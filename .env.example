# ==============================================================================
# Application
# ==============================================================================
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Fortaleza

# Safe local demonstration mode. When enabled, the dashboard uses the demo SQLite
# database and blocks real ERP/SFTP operations.
APP_DEMO=false
DEMO_DB_PATH=storage/database/siw-demo.sqlite

# Structured application logging.
# Supported values: debug, info, warning, error.
LOG_LEVEL=info

# ==============================================================================
# ERP / source PostgreSQL database
#
# Use a dedicated read-only database user in production.
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=database
DB_USER=readonly_user
DB_PASS=change_me

# ==============================================================================
# Local portal database (SQLite)
#
# Relative paths are resolved from the project root.
# ==============================================================================
PORTAL_DB_PATH=storage/database/portal.sqlite

# ==============================================================================
# Export
#
# Identifier used in generated filenames.
# Example: MV20260807_COMPANY.txt
# ==============================================================================
EXPORT_COMPANY=COMPANY

# ==============================================================================
# SFTP destination
# ==============================================================================
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=username
SFTP_PASS=change_me
SFTP_REMOTE_DIR=/DELIVERY

# Trusted SSH host-key fingerprint.
# Prefer SHA-256 format when available.
# Example: SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SFTP_HOST_KEY_FINGERPRINT=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SFTP_TIMEOUT=30
