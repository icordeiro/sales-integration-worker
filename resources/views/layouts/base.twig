<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">

    <title> {{ TITLE|default('NielsenIQ') }} </title>
    
    {# Tabulator 6.5 #}
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.5.0/dist/css/tabulator.min.css">


    {# Tailwind CSS v4 - Browser CDN #}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    {#
        Pequenas extensões necessárias para:
        - identidade visual
        - Tabulator
        - status dinâmicos criados via JS

        Como usamos o Browser CDN do Tailwind,
        não precisamos compilar nada.
    #}

    <style type="text/tailwindcss">

        @theme {
            --color-brand-50: #f4f2ff;
            --color-brand-100: #ebe7ff;
            --color-brand-500: #6655d9;
            --color-brand-600: #5746ca;
            --color-brand-700: #4939b5;
        }


        @layer base {

            html {
                background: #f8fafc;
            }

            body {
                @apply min-h-screen bg-slate-50 text-slate-900 antialiased;
            }

            button {
                cursor: pointer;
            }

            dialog {
                margin: auto;
            }

        }


        /*
        |--------------------------------------------------------------------------
        | Status
        |--------------------------------------------------------------------------
        */

        .status-badge {
            @apply inline-flex items-center rounded-full px-2.5 py-1
                   text-[11px] font-semibold whitespace-nowrap;
        }

        .status-success {
            @apply bg-emerald-50 text-emerald-700;
        }

        .status-danger {
            @apply bg-red-50 text-red-700;
        }

        .status-warning {
            @apply bg-amber-50 text-amber-700;
        }

        .status-neutral {
            @apply bg-slate-100 text-slate-600;
        }

        .status-primary {
            @apply bg-brand-50 text-brand-700;
        }

        .action-feedback {
            @apply mt-3 rounded-lg px-3 py-2 text-xs;
        }

        .action-feedback-success {
            @apply bg-emerald-50 text-emerald-700;
        }

        .action-feedback-error {
            @apply bg-red-50 text-red-700;
        }


        /*
        |--------------------------------------------------------------------------
        | Timeline
        |--------------------------------------------------------------------------
        */

        .timeline-item {
            @apply relative pb-6 pl-8;
        }

        .timeline-item:last-child {
            @apply pb-0;
        }

        .timeline-dot {
            @apply absolute left-[5px] top-[4px]
                   size-3 rounded-full
                   border-[3px] border-brand-600
                   bg-white;
        }

        .timeline-line {
            @apply absolute left-[10px] top-4 bottom-0
                   w-px bg-slate-200;
        }

        .timeline-header {
            @apply flex flex-wrap items-center gap-2;
        }

        .timeline-status {
            @apply text-xs font-semibold text-slate-800;
        }

        .timeline-time {
            @apply text-[11px] text-slate-400;
        }

        .timeline-message {
            @apply mt-1 text-xs leading-relaxed text-slate-500;
        }


        /*
        |--------------------------------------------------------------------------
        | Dialog
        |--------------------------------------------------------------------------
        */

        #execution-dialog::backdrop,
        #action-confirm-dialog::backdrop {
            background: rgb(15 23 42 / 0.45);
        }


        /*
        |--------------------------------------------------------------------------
        | Tabulator
        |--------------------------------------------------------------------------
        */

        #history-table .tabulator {
            border: 0;
            background: transparent;

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        #history-table .tabulator-header {
            border: 0;
            border-bottom: 1px solid #e2e8f0;

            background: #f8fafc;
        }

        #history-table .tabulator-header .tabulator-col {
            border: 0;

            background: #f8fafc;
        }

        #history-table
        .tabulator-header
        .tabulator-col
        .tabulator-col-content {
            padding: 12px 16px;
        }

        #history-table .tabulator-col-title {
            color: #64748b;

            font-size: 10px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        #history-table .tabulator-row {
            min-height: 52px;

            border-bottom: 1px solid #f1f5f9;

            background: #ffffff;

            cursor: pointer;
        }

        #history-table .tabulator-row:hover {
            background: #f8fafc;
        }

        #history-table
        .tabulator-row
        .tabulator-cell {
            padding: 13px 16px;

            border: 0;
            border-right: 0;

            color: #334155;

            font-size: 13px;
            line-height: 26px;

            vertical-align: middle;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #history-table .tabulator-footer {
            padding: 12px 16px;

            border: 0;
            border-top: 1px solid #e2e8f0;

            background: white;
        }

        #history-table .tabulator-page {
            border: 1px solid #e2e8f0;
            border-radius: 7px;

            background: white;

            color: #475569;
        }

        #history-table .tabulator-page:hover {
            background: #f8fafc;
        }

        #history-table .tabulator-page.active {
            border-color: #5746ca;

            background: #5746ca;
            color: white;
        }

        #history-table .tabulator-page-size {
            border: 1px solid #e2e8f0;
            border-radius: 7px;

            background: white;

            color: #334155;
        }

        .execution-dialog {
            width: min(760px, calc(100% - 32px));
            max-height: calc(100vh - 32px);
        }

        .execution-dialog > div {
            max-height: calc(100vh - 32px);
            overflow-y: auto;
        }

        .action-confirm-dialog {
            width: min(520px, calc(100% - 32px));
        }

    </style>


    {% block styles %}{% endblock %}

</head>


<body>

{% block content %}{% endblock %}


{#
|--------------------------------------------------------------------------
| Bibliotecas JS
|--------------------------------------------------------------------------
|
| Ordem importante:
|
| Tabulator
| SheetJS
| jsPDF
| AutoTable
| nosso dashboard.js
|
#}


{# Tabulator #}

<script
    src="https://unpkg.com/tabulator-tables@6.5.0/dist/js/tabulator.min.js"
></script>


{# Excel / SheetJS #}

<script
    src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"
></script>


{# PDF / jsPDF #}

<script
    src="https://cdn.jsdelivr.net/npm/jspdf@4.2.1/dist/jspdf.umd.min.js"
></script>


{# PDF tables #}

<script
    src="https://cdn.jsdelivr.net/npm/jspdf-autotable@5.0.8/dist/jspdf.plugin.autotable.min.js"
></script>


{# Aplicação #}

<script
    src="/assets/pages/dashboard/dashboard.js"
></script>


{% block scripts %}{% endblock %}

</body>

</html>